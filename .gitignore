# Logs and process output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies are always installed independently on each OS/architecture.
# Never copy or commit node_modules between macOS, Windows, Linux or a VM.
node_modules/
.pnp
.pnp.*

# This project uses Bun as its sole package manager (bun.lock is committed).
# Don't commit an npm/yarn/pnpm lockfile — a second lockfile drifts out of sync
# and breaks the Cloudflare deploy's `bun install --frozen-lockfile`.
package-lock.json
yarn.lock
pnpm-lock.yaml

# Generated application and package output
dist/
apps/*/dist*
dist-ssr/
target/
*.local

# TypeScript incremental build info (created by `tsc -b`)
*.tsbuildinfo

# Tool caches and test output
coverage/
.cache/
.turbo/
.vite/
.eslintcache
.stylelintcache
tmp/
temp/
*.tmp

# Large local telemetry/video fixtures used for manual CLI and browser testing.
docs/data/*.ibt
docs/data/*.mp4

# Local Racing Memory source recordings and generated renders. They can be
# hundreds of megabytes and are intentionally never part of the repository.
data/

# Environment — see .env.example for the schema
.env
.env.local
.env.*.local

# Local dev slot for the private AI coach plugin. Production loads the coach as
# an npm package (see apps/web/src/plugins/README.md); this folder lets you iterate on it
# locally without publishing. Absent in the public repo and on Lovable.
apps/web/src/plugins/coaching/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local Tauri desktop build artifacts. The compiled sidecar, generated schemas
# and icons are produced by `tauri dev` / `bun build --compile` on this machine
# and must never be pushed. Rust target directories are ignored globally above.
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/
apps/desktop/src-tauri/icons/
apps/desktop/src-tauri/resources/

# Cargo.lock for the Desktop application is intentionally committed. It pins
# the native dependency graph for reproducible Windows release builds.

{
  "name": "doves-dataviewer",
  "private": true,
  "version": "5.1.1",
  "packageManager": "bun@1.4.4",
  "description": "Open-source, offline-first motorsport telemetry viewer (Dove's DataViewer / LapWing).",
  "license": "GPL-3.0-or-later",
  "author": "TheAngryRaven",
  "homepage": "https://lapwingdata.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAngryRaven/DovesDataViewer.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "beta-proxy"
  ],
  "bugs": {
    "url": "https://github.com/TheAngryRaven/DovesDataViewer/issues"
  },
  "bin": {
    "lapwing": "./apps/cli/src/lapwing.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "build:sim": "bun run --cwd apps/web build:sim",
    "build:full": "bun run --cwd apps/web build:full",
    "build:profiles": "bun run build:sim && bun run build:full && bun run bundle:assert:sim && bun scripts/assert-profile-build.mjs",
    "bundle:assert:sim": "bun scripts/assert-sim-bundle.mjs",
    "build:dev": "bun run --cwd apps/web build:dev",
    "build:desktop:win": "bun run --cwd apps/desktop bundle:win",
    "repo:hygiene": "bun scripts/check-repository-hygiene.mjs",
    "lint": "eslint .",
    "preview": "bun run --cwd apps/web preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:badge": "bun scripts/coverage-badge.mjs",
    "coverage:summary": "bun scripts/coverage-summary.mjs",
    "i18n:seed": "bun scripts/seed-translations.mjs",
    "lapwing": "bun apps/cli/src/lapwing.ts",
    "analysis:serve": "bun scripts/serve-local-analysis.mjs",
    "cli:smoke": "bun scripts/cli-smoke.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^4.1.6"
  },
  "optionalDependencies": {
    "@perchwerks/eye-in-the-sky": "0.5.0"
  }
}
